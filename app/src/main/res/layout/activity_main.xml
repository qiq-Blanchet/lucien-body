<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_title"
            android:textAppearance="@android:style/TextAppearance.Material.Headline" />

        <TextView
            android:id="@+id/permission_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/permission_status_placeholder" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/settings_title"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/supabase_url_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints="url"
            android:hint="@string/supabase_url_hint"
            android:inputType="textUri"
            android:singleLine="true" />

        <EditText
            android:id="@+id/supabase_key_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints="password"
            android:hint="@string/supabase_key_hint"
            android:inputType="textPassword"
            android:singleLine="true" />

        <Switch
            android:id="@+id/boot_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/boot_setting" />

        <Switch
            android:id="@+id/self_talk_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/self_talk_setting" />

        <TextView
            android:id="@+id/self_talk_frequency_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:labelFor="@id/self_talk_frequency_seek" />

        <SeekBar
            android:id="@+id/self_talk_frequency_seek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="30"
            android:min="5" />

        <Switch
            android:id="@+id/loneliness_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/loneliness_setting" />

        <Switch
            android:id="@+id/app_awareness_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_awareness_setting" />

        <TextView
            android:id="@+id/pet_size_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:labelFor="@id/pet_size_seek" />

        <SeekBar
            android:id="@+id/pet_size_seek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="120"
            android:min="60" />

        <TextView
            android:id="@+id/bubble_duration_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:labelFor="@id/bubble_duration_seek" />

        <SeekBar
            android:id="@+id/bubble_duration_seek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="10"
            android:min="2" />

        <Button
            android:id="@+id/reset_position_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/reset_position_button" />

        <Button
            android:id="@+id/save_settings_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/save_settings_button" />

        <Button
            android:id="@+id/start_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/start_button" />

        <Button
            android:id="@+id/stop_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="@string/stop_button" />
    </LinearLayout>
</ScrollView>
